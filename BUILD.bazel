load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
package(default_visibility = ["//visibility:public"])

exports_files([
    "MODULE.bazel",
    "README.md",
    "defs.bzl",
])

# The pinned chart's render: `resource_filters = "@rules_kyverno//:kyverno_manifest"`
# applies its default resourceFilters.
alias(
    name = "kyverno_manifest",
    actual = "//private/manifests:kyverno.yaml",
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    deps = [
        "//private:check",
        "//private:install",
        "//private:policy",
        "//private:providers",
        "//private:test",
    ],
)
