# Policies the check must refuse; each kyverno_policy_test names the error.
load("//:defs.bzl", "kyverno_policy", "kyverno_policy_test")

exports_files(glob(["*.yaml"]))

kyverno_policy_test(
    name = "typo_top_test",
    srcs = ["typo_top.yaml"],
    expect_error = "spec.validationFailureActon: unknown field 'validationFailureActon' \\(did you mean 'validationFailureAction'\\?\\)",
)

kyverno_policy_test(
    name = "typo_nested_test",
    srcs = ["typo_nested.yaml"],
    expect_error = "spec.validations\\[0\\].expresion: unknown field 'expresion' \\(did you mean 'expression'\\?\\)",
)

kyverno_policy_test(
    name = "wrong_type_test",
    srcs = ["wrong_type.yaml"],
    expect_error = "spec.background: expected boolean, got string",
)

kyverno_policy_test(
    name = "bad_cel_test",
    srcs = ["bad_cel.yaml"],
    expect_error = "Syntax error",
)

kyverno_policy_test(
    name = "two_validations_test",
    srcs = ["two_validations.yaml"],
    expect_error = "Kyverno skipped: .*only one of pattern, anyPattern, deny, foreach, cel can be specified",
)

kyverno_policy_test(
    name = "not_yaml_test",
    srcs = ["not_yaml.yaml"],
    expect_error = "not_yaml.yaml:1: not valid YAML",
)

kyverno_policy_test(
    name = "not_a_policy_test",
    srcs = ["not_a_policy.yaml"],
    expect_error = "v1/ConfigMap is not a Kyverno policy kind",
)

# The good policies pass the same test (no expect_error).
kyverno_policy_test(
    name = "good_policies_test",
    srcs = [
        "//tests/policies:add_team.yaml",
        "//tests/policies:admission.yaml",
        "//tests/policies:exceptions.yaml",
        "//tests/policies:no_latest_cel.yaml",
        "//tests/policies:require_team.yaml",
    ],
)

# For the by-hand / CI check that a bad policy fails `bazel build`; manual,
# so `//...` skips it.
kyverno_policy(
    name = "typo_top",
    srcs = ["typo_top.yaml"],
    tags = ["manual"],
)

# Kubernetes admission policies: CEL is compiled, bound or not (#1).
kyverno_policy_test(
    name = "vap_bad_cel_test",
    srcs = ["vap_bad_cel.yaml"],
    expect_error = "tests/bad/vap_bad_cel.yaml: Kyverno: ValidatingAdmissionPolicy vap-bad-cel: .*Syntax error",
)

kyverno_policy_test(
    name = "map_bad_cel_test",
    srcs = ["map_bad_cel.yaml"],
    expect_error = "tests/bad/map_bad_cel.yaml: Kyverno: map-bad-cel: compilation failed: .*Syntax error",
)

# Behind matchConditions the probe doesn't meet, every CEL expression is
# still compiled, and named by its field when the CLI can't name it (#5).
[kyverno_policy_test(
    name = name,
    srcs = [src],
    expect_error = expect,
) for name, src, expect in [
    ("vap_mc_validation_test", "vap_match_conditions.yaml", "^  tests/bad/vap_match_conditions.yaml: Kyverno: ValidatingAdmissionPolicy vap-match-conditions: .*Syntax error"),
    ("vap_mc_variable_test", "vap_match_conditions.yaml", "vap-match-conditions \\(spec.variables\\[0\\] \\(replicas\\)\\): .*<input>:1:1: undeclared reference to 'objet'"),
    ("vap_mc_message_test", "vap_match_conditions.yaml", "vap-match-conditions \\(spec.validations\\[0\\].messageExpression\\): .*undeclared reference to 'objekt'"),
    ("vap_mc_audit_test", "vap_match_conditions.yaml", "vap-match-conditions \\(spec.auditAnnotations\\[0\\] \\(owner\\)\\): .*undeclared reference to 'owner'"),
    ("map_mc_mutation_test", "map_match_conditions.yaml", "^  tests/bad/map_match_conditions.yaml: Kyverno: map-match-conditions: compilation failed: .*undeclared reference to 'objet'"),
    ("map_mc_variable_test", "map_match_conditions.yaml", "map-match-conditions \\(spec.variables\\[0\\] \\(tier\\)\\): .*undeclared reference to 'tier'"),
]]

# With several files, each load problem names its file (#2), and a CEL
# compile error in one file doesn't hide the others' problems.
[kyverno_policy_test(
    name = name,
    srcs = [
        "//tests/policies:require_team.yaml",
        "bad_cel.yaml",
        "two_validations.yaml",
        "vap_bad_cel.yaml",
    ],
    expect_error = expect,
) for name, expect in [
    ("names_file_skipped_test", "^  tests/bad/two_validations.yaml: Kyverno skipped: .*only one of"),
    ("names_file_cel_test", "^  tests/bad/bad_cel.yaml: Kyverno: .*Syntax error"),
    ("names_file_vap_test", "^  tests/bad/vap_bad_cel.yaml: Kyverno: ValidatingAdmissionPolicy"),
]]

# ImageValidatingPolicy: also needs the ConfigMap probe; compiled offline.
kyverno_policy_test(
    name = "ivp_bad_cel_test",
    srcs = ["ivp_bad_cel.yaml"],
    expect_error = "tests/bad/ivp_bad_cel.yaml: Kyverno: KyvernoImageValidatingPolicy ivp-bad-cel: failed to compile policy",
    tags = ["block-network"],
)
